{
  "name": "@sideband/channels",
  "version": "0.1.0",
  "description": "Sideband channels SDK: domain-separated cumulative vouchers and channel adapters (Testnet/synthetic only).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ]
}
